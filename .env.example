# Application Configuration
APP_NAME=iRekon
APP_ENV=development
SECRET_KEY=change-this-super-secret-key-in-production

# PostgreSQL Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5433
POSTGRES_USER=irekon
POSTGRES_PASSWORD=irekon_pass
POSTGRES_DB=irekon_db
DATABASE_URL=postgresql://irekon:irekon_pass@postgres:5432/irekon_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PORT_HOST=6380
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# MinIO S3 Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_ARCHIVE=archive
MINIO_BUCKET_TEMP=temp

# Services URL
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
